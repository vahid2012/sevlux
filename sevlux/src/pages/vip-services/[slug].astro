---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import TOC from '../../components/TOC.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const services = await getCollection('vipServices');
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content, headings } = await render(service);

const allServices = (await getCollection('vipServices')).sort((a, b) =>
  a.data.slug.localeCompare(b.data.slug),
);
const otherServices = allServices.filter((s) => s.data.slug !== service.data.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: service.data.description,
  url: `${SITE.url}/vip-services/${service.data.slug}/`,
  image: service.data.image,
  provider: {
    '@type': 'TravelAgency',
    name: SITE.name,
    url: SITE.url,
  },
  areaServed: 'Istanbul, Turkey',
};

const waMessage = `Hello, I'm interested in: ${service.data.title}. Can you provide more details and pricing?`;
const keywordsMeta = service.data.keywords.join(', ');
---

<Layout
  title={`${service.data.title} | Istanbul VIP Services`}
  description={service.data.description}
  image={service.data.image}
  canonical={`/vip-services/${service.data.slug}/`}
  jsonLd={jsonLd}
>
  <meta slot="head" name="keywords" content={keywordsMeta} />

  <Hero
    title={service.data.title}
    subtitle={service.data.description}
    image={service.data.image}
    imageAlt={service.data.title}
  />

  <div class="vip-sub-page">
    <div class="vip-breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/istanbul-vip-services/">VIP Services</a>
      <span>/</span>
      <span>{service.data.title}</span>
    </div>

    <div class="vip-content-wrapper">
      <div class="vip-content-main">
        {service.data.longForm && <TOC headings={headings} />}
        <div class="prose">
          <Content />
        </div>

        <div class="vip-cta-box">
          <h3>Book {service.data.title}</h3>
          <p>Contact our VIP concierge team on WhatsApp for pricing and availability. We respond within minutes.</p>
          <WhatsAppButton message={waMessage} label="Contact VIP Concierge" />
        </div>
      </div>

      <aside class="vip-sidebar">
        <h3>All VIP Services</h3>
        <nav class="vip-sub-nav">
          {allServices.map((s) => (
            <a
              href={`/vip-services/${s.data.slug}/`}
              class={s.data.slug === service.data.slug ? 'active' : ''}
            >
              <span class="vip-nav-icon">{s.data.icon}</span>
              <span class="vip-nav-label">{s.data.title}</span>
            </a>
          ))}
        </nav>
        <a href="/istanbul-vip-services/" class="vip-back-link">← Back to VIP Services Overview</a>
      </aside>
    </div>

    <section class="vip-other-services">
      <h2>Other VIP Services</h2>
      <div class="vip-other-grid">
        {otherServices.map((s) => (
          <a href={`/vip-services/${s.data.slug}/`} class="vip-other-card">
            <img src={s.data.image} alt={s.data.title} loading="lazy" width="300" height="170" />
            <div class="vip-other-body">
              <span class="vip-other-icon">{s.data.icon}</span>
              <h3>{s.data.title}</h3>
              <p>{s.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .vip-sub-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3) 24px var(--space-5);
  }

  .vip-breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--c-gray-400);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .vip-breadcrumb a {
    color: var(--c-primary);
  }

  .vip-breadcrumb span:last-child {
    color: var(--c-gray-600);
    font-weight: 500;
  }

  .vip-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 32px;
  }

  .vip-content-main {
    min-width: 0;
  }

  .vip-cta-box {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-dark) 100%);
    border-radius: var(--radius);
    text-align: center;
    color: var(--c-white);
  }

  .vip-cta-box h3 {
    color: var(--c-white);
    font-size: 24px;
    margin-bottom: 8px;
  }

  .vip-cta-box p {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-2);
  }

  .vip-sidebar {
    position: sticky;
    top: 80px;
    align-self: start;
  }

  .vip-sidebar h3 {
    font-size: 18px;
    margin-bottom: var(--space-2);
    padding-bottom: 10px;
    border-bottom: 2px solid var(--c-gray-200);
  }

  .vip-sub-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: var(--space-3);
  }

  .vip-sub-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--c-gray-600);
    transition: all 0.2s ease;
  }

  .vip-sub-nav a:hover {
    background: var(--c-gray-50);
    color: var(--c-primary);
  }

  .vip-sub-nav a.active {
    background: var(--c-primary);
    color: var(--c-white);
  }

  .vip-nav-icon {
    font-size: 18px;
    flex-shrink: 0;
  }

  .vip-back-link {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--c-primary);
    padding: 10px 14px;
  }

  .vip-other-services {
    margin-top: var(--space-5);
  }

  .vip-other-services h2 {
    font-size: 28px;
    margin-bottom: var(--space-3);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--c-gray-200);
  }

  .vip-other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .vip-other-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--c-gray-200);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    background: var(--c-white);
    transition: all 0.2s ease;
  }

  .vip-other-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .vip-other-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }

  .vip-other-body {
    padding: 16px;
  }

  .vip-other-icon {
    font-size: 24px;
    margin-bottom: 6px;
    display: block;
  }

  .vip-other-body h3 {
    font-size: 16px;
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .vip-other-body p {
    font-size: 13px;
    color: var(--c-gray-600);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .vip-content-wrapper {
      grid-template-columns: 1fr;
    }

    .vip-sidebar {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 600px) {
    .vip-other-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
