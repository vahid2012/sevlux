---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TOC from '../../components/TOC.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image,
  datePublished: post.data.pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: `${SITE.url}/blog/${post.data.slug}/`,
};

const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.data.category === post.data.category && p.data.slug !== post.data.slug)
  .slice(0, 3);

const waMessage = `Hello, I read your article "${post.data.title}" and would like more information.`;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  jsonLd={jsonLd}
>
  <article class="blog-article">
    <div class="blog-header">
      <span class="blog-category-badge">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p class="blog-meta">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <img
        src={post.data.image}
        alt={post.data.title}
        class="blog-hero-img"
        fetchpriority="high"
        width="1200"
        height="600"
      />
    </div>

    <TOC headings={headings} />

    <div class="prose">
      <Content />
    </div>

    <div class="blog-cta">
      <h3>Questions about this article?</h3>
      <p>Message us on WhatsApp for personalized advice.</p>
      <WhatsAppButton message={waMessage} label="Ask us on WhatsApp" />
    </div>

    {relatedPosts.length > 0 && (
      <div class="related-posts">
        <h2>Related Articles</h2>
        <ul>
          {relatedPosts.map((rp) => (
            <li><a href={`/blog/${rp.data.slug}/`}>{rp.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Layout>

<style>
  .blog-article {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-4) 24px var(--space-5);
  }

  .blog-header {
    margin-bottom: var(--space-3);
  }

  .blog-category-badge {
    display: inline-block;
    background: var(--c-accent);
    color: var(--c-white);
    font-size: 13px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-1);
  }

  .blog-header h1 {
    font-size: 36px;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .blog-meta {
    color: var(--c-gray-400);
    font-size: 15px;
    margin-bottom: var(--space-3);
  }

  .blog-hero-img {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .blog-cta {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--c-gray-50);
    border-radius: var(--radius);
    text-align: center;
  }

  .blog-cta h3 {
    font-size: 24px;
    margin-bottom: 8px;
  }

  .blog-cta p {
    color: var(--c-gray-600);
    margin-bottom: var(--space-2);
  }

  .related-posts {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--c-gray-200);
  }

  .related-posts h2 {
    font-size: 24px;
    margin-bottom: var(--space-2);
  }

  .related-posts ul {
    list-style: none;
  }

  .related-posts li {
    margin-bottom: 8px;
  }

  .related-posts a {
    font-size: 17px;
  }

  @media (max-width: 768px) {
    .blog-header h1 {
      font-size: 26px;
    }
  }
</style>
