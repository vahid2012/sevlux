---
export interface Props {
  title?: string;
  class?: string;
  centered?: boolean;
}
const { title, class: className = '', centered = false } = Astro.props;
---

<section class={`section ${centered ? 'section--centered' : ''} ${className}`}>
  {title && <h2 class="section-title">{title}</h2>}
  <div class="section-body">
    <slot />
  </div>
</section>

<style>
  .section {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    padding: var(--space-4, 32px) 24px;
  }

  .section--centered {
    text-align: center;
  }

  .section-title {
    font-size: 32px;
    margin-bottom: var(--space-3, 24px);
    color: var(--c-dark, #1a2332);
  }

  .section--centered .section-title {
    text-align: center;
  }
</style>
